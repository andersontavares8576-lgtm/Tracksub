# TRACKSUB - Variáveis de Ambiente Recomendadas
# No Netlify, defina estas variáveis em: Site configuration > Environment variables

# Variáveis do Firebase Client SDK (Configuração Pública da Web)
VITE_FIREBASE_API_KEY="sua-api-key-do-firebase"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_DATABASE_ID="ai-studio-tracksubgestoera-291c7cb2-03a0-46f1-ab57-ed0aa0d12b8b"

# Host e APIs
GEMINI_API_KEY=""
