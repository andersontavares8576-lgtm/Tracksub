{
  "entities": {
    "Usuario": {
      "title": "Usuario",
      "description": "Usuário autenticado do sistema TRACKSUB com controle de perfil e permissões de acesso.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "UID do usuário no Firebase Auth" },
        "nome": { "type": "string", "description": "Nome completo do usuário" },
        "email": { "type": "string", "format": "email", "description": "E-mail de acesso corporativo" },
        "perfil": {
          "type": "string",
          "enum": ["administrador", "gestor", "tecnico", "almoxarife", "consulta"],
          "description": "Nível de acesso e permissões operacionais"
        },
        "matricula": { "type": "string", "description": "Matrícula funcional ou registro" },
        "cargo": { "type": "string", "description": "Cargo ou função técnica" },
        "ativo": { "type": "boolean", "description": "Status de ativação da conta" },
        "criadoEm": { "type": "string", "description": "Data ISO de criação" },
        "ultimoAcesso": { "type": "string", "description": "Data ISO do último login" }
      },
      "required": ["id", "nome", "email", "perfil", "ativo"]
    },
    "Equipamento": {
      "title": "Equipamento",
      "description": "Ativo ou equipamento elétrico de subestação rastreado individualmente por QR Code único.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identificador único do documento" },
        "codigoPatrimonial": { "type": "string", "description": "Código patrimonial único (ex: PAT-2026-0001)" },
        "tipo": { "type": "string", "description": "Classificação técnica do ativo" },
        "descricao": { "type": "string", "description": "Descrição detalhada do equipamento" },
        "fabricante": { "type": "string", "description": "Fabricante do ativo" },
        "modelo": { "type": "string", "description": "Modelo técnico do equipamento" },
        "numeroSerie": { "type": "string", "description": "Número de série individual do fabricante" },
        "qrCode": { "type": "string", "description": "Identificador ou URL direta do QR Code individual" },
        "subestacaoId": { "type": "string", "description": "ID da subestação alocada" },
        "painelId": { "type": "string", "description": "ID do painel alocado" },
        "moduloId": { "type": "string", "description": "ID ou identificação do módulo/vão" },
        "almoxarifadoId": { "type": "string", "description": "ID do almoxarifado de guarda se em estoque" },
        "localizacaoDescricao": { "type": "string", "description": "Descrição textual da localização física" },
        "estadoConservacao": { "type": "string", "description": "Estado físico de conservação" },
        "estadoOperacional": {
          "type": "string",
          "enum": ["Em Operação", "Sobressalente / Estoque", "Em Manutenção", "Em Ensaio", "Retirado", "Baixado"],
          "description": "Status operacional do ativo"
        },
        "responsavel": { "type": "string", "description": "Responsável técnico atual" },
        "dataRetirada": { "type": "string", "description": "Data da retirada do ativo se aplicável" },
        "dataInstalacao": { "type": "string", "description": "Data de instalação do ativo" },
        "dataAquisicao": { "type": "string", "description": "Data de registro/aquisição (retrocompatibilidade)" },
        "garantiaAte": { "type": "string", "description": "Garantia até (retrocompatibilidade)" },
        "observacoes": { "type": "string", "description": "Observações técnicas" },
        "criadoEm": { "type": "string", "description": "Data ISO de criação" },
        "atualizadoEm": { "type": "string", "description": "Data ISO de atualização" }
      },
      "required": ["id", "codigoPatrimonial", "tipo", "descricao", "fabricante", "modelo", "numeroSerie", "estadoOperacional"]
    },
    "Movimentacao": {
      "title": "Movimentacao",
      "description": "Evento histórico append-only de movimentação, instalação, retirada ou transferência de equipamento.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identificador do registro histórico" },
        "equipamentoId": { "type": "string", "description": "ID do equipamento movimentado" },
        "equipamentoDescricao": { "type": "string", "description": "Descrição do equipamento" },
        "equipamentoPatrimonio": { "type": "string", "description": "Código patrimonial" },
        "tipoOperacao": {
          "type": "string",
          "enum": ["Instalação", "Retirada", "Transferência de Painel", "Transferência de Subestação", "Envio para Manutenção", "Envio para Ensaios", "Retorno ao Almoxarifado", "Entrada de Estoque", "Baixa Patrimonial"],
          "description": "Tipo de evento de movimentação"
        },
        "origemSubestacaoId": { "type": "string", "description": "Subestação de origem" },
        "origemSubestacaoNome": { "type": "string", "description": "Nome da SE de origem" },
        "origemPainelNome": { "type": "string", "description": "Painel de origem" },
        "origemModuloNome": { "type": "string", "description": "Módulo de origem" },
        "destinoSubestacaoId": { "type": "string", "description": "Subestação de destino" },
        "destinoSubestacaoNome": { "type": "string", "description": "Nome da SE de destino" },
        "destinoPainelNome": { "type": "string", "description": "Painel de destino" },
        "destinoModuloNome": { "type": "string", "description": "Módulo de destino" },
        "destinoAlmoxarifadoNome": { "type": "string", "description": "Almoxarifado de destino" },
        "dataHora": { "type": "string", "description": "Data e hora ISO do evento" },
        "usuarioId": { "type": "string", "description": "ID do usuário executor" },
        "usuarioNome": { "type": "string", "description": "Nome do usuário responsável" },
        "usuarioPerfil": { "type": "string", "description": "Perfil do usuário" },
        "motivo": { "type": "string", "description": "Justificativa da operação" },
        "ordemServicoId": { "type": "string", "description": "ID da Ordem de Serviço associada" },
        "ordemServicoNumero": { "type": "string", "description": "Número formatado da OS" },
        "observacoes": { "type": "string", "description": "Observações adicionais" }
      },
      "required": ["id", "equipamentoId", "equipamentoPatrimonio", "tipoOperacao", "dataHora", "usuarioNome", "motivo"]
    },
    "Subestacao": {
      "title": "Subestacao",
      "description": "Subestação de transmissão ou distribuição de energia elétrica.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID da subestação" },
        "codigo": { "type": "string", "description": "Sigla ou código operacional (ex: SE-EST-230)" },
        "nome": { "type": "string", "description": "Nome da subestação" },
        "tensaoPrimaria": { "type": "string", "description": "Nível de tensão primária" },
        "tensaoSecundaria": { "type": "string", "description": "Nível de tensão secundária" },
        "endereco": { "type": "string", "description": "Endereço físico" },
        "cidade": { "type": "string", "description": "Município" },
        "uf": { "type": "string", "description": "Estado" },
        "ativa": { "type": "boolean", "description": "Indica se está energizada e ativa" }
      },
      "required": ["id", "codigo", "nome", "ativa"]
    },
    "Painel": {
      "title": "Painel",
      "description": "Painel elétrico ou cubículo instalado em subestação.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do painel" },
        "subestacaoId": { "type": "string", "description": "ID da subestação vinculada" },
        "identificacao": { "type": "string", "description": "Identificação/tag do painel" },
        "tipo": { "type": "string", "description": "Tipo do painel" },
        "fabricante": { "type": "string", "description": "Fabricante do painel" }
      },
      "required": ["id", "subestacaoId", "identificacao"]
    },
    "Modulo": {
      "title": "Modulo",
      "description": "Módulo funcional, gaveta ou vão associado a um painel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do módulo" },
        "subestacaoId": { "type": "string", "description": "Subestação vinculada" },
        "painelId": { "type": "string", "description": "Painel vinculado" },
        "identificacao": { "type": "string", "description": "Identificação do vão/módulo" },
        "codigo": { "type": "string", "description": "Código do módulo" },
        "posicao": { "type": "string", "description": "Posição física ou gaveta" }
      },
      "required": ["id", "identificacao"]
    },
    "Almoxarifado": {
      "title": "Almoxarifado",
      "description": "Local físico de armazenamento e estoque de sobressalentes e materiais.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do almoxarifado" },
        "codigo": { "type": "string", "description": "Código do depósito" },
        "nome": { "type": "string", "description": "Nome do almoxarifado" },
        "localizacao": { "type": "string", "description": "Endereço ou pátio" },
        "responsavel": { "type": "string", "description": "Responsável pela guarda" },
        "ativo": { "type": "boolean", "description": "Status do almoxarifado" }
      },
      "required": ["id", "codigo", "nome", "ativo"]
    },
    "Fornecedor": {
      "title": "Fornecedor",
      "description": "Fabricante, distribuidor ou prestador de ensaios e calibração de equipamentos.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do fornecedor" },
        "razaoSocial": { "type": "string", "description": "Razão social" },
        "nomeFantasia": { "type": "string", "description": "Nome fantasia" },
        "cnpj": { "type": "string", "description": "CNPJ cadastrado" },
        "contato": { "type": "string", "description": "Nome do contato" },
        "telefone": { "type": "string", "description": "Telefone de contato" },
        "email": { "type": "string", "description": "E-mail de contato" },
        "categoriaFornecimento": { "type": "string", "description": "Categoria de fornecimento" },
        "ativo": { "type": "boolean", "description": "Status do fornecedor" }
      },
      "required": ["id", "razaoSocial", "ativo"]
    },
    "Material": {
      "title": "Material",
      "description": "Item de estoque, consumível ou sobressalente elétrico.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do material" },
        "codigo": { "type": "string", "description": "Código do item" },
        "descricao": { "type": "string", "description": "Descrição do material" },
        "categoria": { "type": "string", "description": "Categoria de estoque" },
        "unidadeMedida": { "type": "string", "description": "Unidade (un, m, kg)" },
        "quantidadeAtual": { "type": "number", "description": "Saldo em estoque" },
        "estoqueMinimo": { "type": "number", "description": "Ponto de ressuprimento mínimo" }
      },
      "required": ["id", "codigo", "descricao", "quantidadeAtual", "estoqueMinimo"]
    },
    "OrdemServico": {
      "title": "OrdemServico",
      "description": "Ordem de serviço de manutenção ou intervenção técnica.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID da OS" },
        "numero": { "type": "string", "description": "Número formatado da OS" },
        "titulo": { "type": "string", "description": "Título da intervenção" },
        "status": { "type": "string", "description": "Status da OS" },
        "subestacaoId": { "type": "string", "description": "Subestação de atendimento" },
        "prioridade": { "type": "string", "description": "Prioridade operacional" }
      },
      "required": ["id", "numero", "titulo", "status"]
    },
    "InventarioFisico": {
      "title": "InventarioFisico",
      "description": "Contagem e conciliação física de ativos e materiais.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do inventário" },
        "codigo": { "type": "string", "description": "Código da contagem" },
        "dataCriacao": { "type": "string", "description": "Data de abertura" },
        "tipoLocal": { "type": "string", "description": "subestacao ou almoxarifado" },
        "localId": { "type": "string", "description": "ID do local" },
        "localNome": { "type": "string", "description": "Nome do local" },
        "responsavelNome": { "type": "string", "description": "Responsável" },
        "status": { "type": "string", "description": "Status da contagem" }
      },
      "required": ["id", "codigo", "status"]
    },
    "AuditoriaLog": {
      "title": "AuditoriaLog",
      "description": "Registro de auditoria de operações e segurança.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do log" },
        "timestamp": { "type": "string", "description": "Data e hora ISO" },
        "usuarioId": { "type": "string", "description": "ID do usuário" },
        "usuarioNome": { "type": "string", "description": "Nome do usuário" },
        "acao": { "type": "string", "description": "Ação executada" },
        "detalhes": { "type": "string", "description": "Detalhes da ação" }
      },
      "required": ["id", "timestamp", "usuarioNome", "acao"]
    },
    "ConfiguracaoSistema": {
      "title": "ConfiguracaoSistema",
      "description": "Parâmetros globais de configuração do TRACKSUB.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do documento singleton" },
        "nomeEmpresa": { "type": "string", "description": "Razão social ou nome da concessionária" },
        "sistemaNome": { "type": "string", "description": "Nome da plataforma" },
        "versao": { "type": "string", "description": "Versão do sistema" },
        "prefixoPatrimonio": { "type": "string", "description": "Prefixo padrão de patrimônio" },
        "atualizadoEm": { "type": "string", "description": "Data de atualização" }
      },
      "required": ["id", "nomeEmpresa", "sistemaNome"]
    }
  },
  "firestore": {
    "/usuarios/{usuarioId}": {
      "schema": { "$ref": "#/entities/Usuario" },
      "description": "Perfis e permissões de usuários autenticados."
    },
    "/equipamentos/{equipamentoId}": {
      "schema": { "$ref": "#/entities/Equipamento" },
      "description": "Equipamentos e ativos rastreados por QR Code individual."
    },
    "/movimentacoes/{movimentacaoId}": {
      "schema": { "$ref": "#/entities/Movimentacao" },
      "description": "Histórico imutável de movimentações e rastreabilidade."
    },
    "/subestacoes/{subestacaoId}": {
      "schema": { "$ref": "#/entities/Subestacao" },
      "description": "Subestações cadastradas na base."
    },
    "/paineis/{painelId}": {
      "schema": { "$ref": "#/entities/Painel" },
      "description": "Painéis e cubículos elétricos."
    },
    "/modulos/{moduloId}": {
      "schema": { "$ref": "#/entities/Modulo" },
      "description": "Módulos, gavetas e vãos associados."
    },
    "/almoxarifados/{almoxarifadoId}": {
      "schema": { "$ref": "#/entities/Almoxarifado" },
      "description": "Almoxarifados e depósitos físicos."
    },
    "/fornecedores/{fornecedorId}": {
      "schema": { "$ref": "#/entities/Fornecedor" },
      "description": "Fabricantes e fornecedores credenciados."
    },
    "/materiais/{materialId}": {
      "schema": { "$ref": "#/entities/Material" },
      "description": "Estoque de materiais e sobressalentes."
    },
    "/ordensServico/{ordemId}": {
      "schema": { "$ref": "#/entities/OrdemServico" },
      "description": "Ordens de serviço de manutenção."
    },
    "/inventarios/{inventarioId}": {
      "schema": { "$ref": "#/entities/InventarioFisico" },
      "description": "Inventários e contagens físicas."
    },
    "/auditoria/{auditoriaId}": {
      "schema": { "$ref": "#/entities/AuditoriaLog" },
      "description": "Trilha de auditoria das operações do sistema."
    },
    "/configuracoes/{configId}": {
      "schema": { "$ref": "#/entities/ConfiguracaoSistema" },
      "description": "Parâmetros de configuração global do sistema."
    }
  }
}
